# Pinch Developer Portal keys. Never expose PINCH_CLIENT_SECRET to the browser.

# Public key used by Pinch CaptureJS in the browser
PINCH_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Vite exposes only this key to the frontend
VITE_PINCH_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Backend-only credentials
PINCH_CLIENT_ID=app_test_your_client_id
PINCH_CLIENT_SECRET=sk_test_your_client_secret

# test or live
PINCH_ENV=test

# BotNews endpoint used by BotWallet backend for the 402 flow
BOTNEWS_BASE_URL=http://localhost:3001
BOTNEWS_DEFAULT_REPORT_ID=market-report-001

# Optional: comma-separated list of allowed browser origins for CORS
# BOTWALLET_ALLOWED_ORIGINS=https://your-botwallet-site.vercel.app

# Optional local Vite proxy override (defaults to http://localhost:8000)
# BOTWALLET_DEV_API_PROXY=http://localhost:8000

# Optional frontend override when BotWallet UI is hosted separately from backend
# VITE_BOTWALLET_API_BASE_URL=https://your-botwallet-api.vercel.app

PORT=8000

# Server-only Gemini key for controlled merchant routing. Do not use a VITE_ prefix.
GEMINI_API_KEY=replace-with-your-server-only-gemini-key

# Required in production for the BotWallet MCP endpoint. Keep server-side only.
MCP_AUTH_TOKEN=replace-with-a-long-random-token
